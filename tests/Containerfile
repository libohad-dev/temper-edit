# Locally-built base image with all external dependencies
ARG IMAGE_TAG
FROM localhost/temper-edit-test-base:${IMAGE_TAG}

WORKDIR /app
COPY pyproject.toml .
COPY src/ .
RUN uv venv --system-site-packages && \
    uv pip install --no-deps .
WORKDIR /root

ENTRYPOINT ["/bin/sleep"]
CMD ["infinity"]
