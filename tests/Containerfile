# Locally-built base image with all external dependencies
ARG IMAGE_TAG
FROM localhost/temper-edit-test-base:${IMAGE_TAG}

WORKDIR /app
COPY --chmod=444 pyproject.toml .
COPY src/ .
RUN pip install --break-system-packages --no-cache-dir --root-user-action=ignore --editable . && \
    chmod --recursive a+rX temper_edit
WORKDIR /root

ENTRYPOINT ["/bin/sleep"]
CMD ["infinity"]
