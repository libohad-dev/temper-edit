ARG IMAGE_TAG
FROM docker.io/library/python:${IMAGE_TAG}

RUN adduser -D -u 1000 user

WORKDIR /app
COPY pyproject.toml .
COPY src/ .
RUN pip install --no-cache-dir . && \
    rm -r /app
WORKDIR /root

ENTRYPOINT ["/bin/sleep"]
CMD ["infinity"]
